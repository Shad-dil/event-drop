# ── Database ──────────────────────────────────────────────
DATABASE_URL=

# ── Auth (api/.env) ───────────────────────────────────────
JWT_SECRET=secret123
JWT_REFRESH_SECRET=jwtresfresh123
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
GUEST_SESSION_SECRET=guestsessionsecret@123

# ── Cloudflare R2 (api/.env) ──────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ── Server (api/.env) ─────────────────────────────────────
PORT=8081
NODE_ENV=development
WEB_APP_URL=http://localhost:3000

# ── Frontend (web/.env.local) ─────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8081/api
